Bootstrap: docker
From: python:3.12-slim-bookworm

%files
    examples/packaged/packages/summary-task /opt/summary-task

%post
    python -m pip install --no-deps /opt/summary-task

%test
    python -c 'import importlib.util; assert importlib.util.find_spec("gwflow") is None'
    python -m summary_task --help
